<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定义CPU日志专属 Appender -->
    <appender name="CPU_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.monitor_logs/cpu_usage.log</file>  <!-- 指定独立文件 -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>  <!-- 简化日志格式 -->
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.monitor_logs/cpu_usage-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 定义内存日志专属 Appender -->
    <appender name="MEMORY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.monitor_logs/memory_usage.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.monitor_logs/memory_usage-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <logger name="CPU_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="CPU_FILE" />
    </logger>

    <logger name="MEMORY_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="MEMORY_FILE" />
    </logger>
</configuration>